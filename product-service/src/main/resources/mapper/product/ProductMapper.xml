<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.ecommerce.productservice.mapper.product.ProductMapper">
    <resultMap id="ProductResultMap" type="com.company.ecommerce.productservice.model.Product">
        <id property="id" column="id"/>
        <result property="spuId" column="spu_id"/>
        <result property="skuCode" column="sku_code"/>
        <result property="name" column="name"/>
        <result property="brand" column="brand"/>
        <result property="categoryId" column="category_id"/>
        <result property="description" column="description"/>
        <result property="price" column="price"/>
        <result property="stock" column="stock"/>
        <result property="mainImageUrl" column="main_image_url"/>
        <result property="status" column="status"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

          <insert id="insert"
                  parameterType="com.company.ecommerce.productservice.model.Product"
                  useGeneratedKeys="true"
                  keyProperty="id">
              insert into products(
                                   spu_id,
                                   sku_code,
                                   name,
                                   brand,
                                   category_id,
                                   description,
                                   price,
                                   stock,
                                   main_image_url,
                                   status,
                                   is_deleted
                                   ) 
                                    values (
                                             #{spuId},
                                             #{skuCode},
                                             #{name},
                                             #{brand},
                                             #{categoryId},
                                             #{description},
                                             #{price},
                                             #{stock},
                                             #{mainImageUrl},
                                             #{status},
                                             #{isDeleted}
                                             )
          </insert>
    
    <select id="findById" resultMap="ProductResultMap" >
        select
            id,
            spu_id,
            sku_code,
            name,
            brand,
            category_id,
            description,
            price,
            stock,
            main_image_url,
            status,
            is_deleted,
            created_at,
            updated_at
            from products where id = #{id} and is_deleted = 0
    </select>

    <select id="findInIds" resultMap="ProductResultMap">
        select * from products
        where id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="findBySkuCode" resultMap="ProductResultMap">
    select  id,
            spu_id,
            sku_code,
            name,
            brand,
            category_id,
            description,
            price,
            stock,
            main_image_url,
            status,
            is_deleted,
            created_at,
            updated_at from products where sku_code = #{skuCode} and is_deleted = 0    

    </select>

    <select id="findBySpuIdProductList" resultMap="ProductResultMap">
        select *
        from products
        where spu_id = #{spuId}
    </select>

    <select id="findAll" resultMap="ProductResultMap">
        select * from products
        where is_deleted = 0
        and  status = 'ACTIVE'

        <if test="categoryIds != null and categoryIds.size()>0">
            and category_id IN
            <foreach collection="categoryIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>

        order by id desc
        LIMIT 9 offset #{page}
    </select>
    
    <select id="findByCategoryId" resultMap="ProductResultMap">
        select * from products 
                 where category_id = #{categoryId} 
                 and is_deleted = 0

    </select>


    <update id="softDeleteById">
        update products
        set is_deleted = 1
        where id = #{id} 
        and is_deleted = 0
    </update>
    
    <update id="update" parameterType="com.company.ecommerce.productservice.model.Product">
        update products
        set
            name = #{name},
            brand = #{brand},
            category_id = #{categoryId},
            description = #{description},
            price = #{price},
            stock = #{stock},
            main_image_url = #{mainImageUrl},
            status = #{status}
        where id = #{id}
        and is_deleted = 0
    </update>

    <update id="findByIdDeductTheStock">
        update products
        set stock = stock - case id
    <foreach collection="items" item="item" >
        when #{item.id} then #{item.quantity}
    </foreach>
        else 0
        end

        where id  in
        <foreach collection="items" open="(" item="item" close=")" separator=",">
            #{item.id}
        </foreach>
    </update>

    <select id="selectProductCount" resultType="int">
        select count(*)
        from products
        where is_deleted = 0
        and  status ='ACTIVE'
        <if test="categoryIds != null and categoryIds.size()>0">
            and category_id in
            <foreach collection="categoryIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>
    <update id="replenishProductStock">
        update products
        set stock = stock + case id
        <foreach collection="items" item="item">
            when #{item.productId} then #{item.quantity}
        </foreach>
        else 0
        end
        where id in
        <foreach collection="items" item="item" open="(" separator="," close=")">
            #{item.productId}
        </foreach>
    </update>

</mapper>
