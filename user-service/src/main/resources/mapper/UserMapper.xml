<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.ecommerce.userservice.mapper.user.UserMapper">

    <resultMap id="UserResulMap" type="com.company.ecommerce.userservice.model.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="status" column="status"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>


    </resultMap>
    <insert id="insert" parameterType="com.company.ecommerce.userservice.model.User" useGeneratedKeys="true"
            keyProperty="id">
        insert into users(username,email,password_hash,status)
        values (#{username},#{email},#{passwordHash},#{status})
    </insert>

    <select id="findByEmail" resultMap="UserResulMap">
        select * from users where email = #{email}
    </select>

    <select id="findByUsername" resultMap="UserResulMap">
        select * from users where username = #{username}
    </select>

    <select id="findById" resultMap="UserResulMap">
        select * from users where id = #{id}
    </select>


</mapper>